# ==============================================================================
# Environment Configuration Template for Kuchu Puchu
# Copy this file to '.env' and fill in your own API keys.
# NEVER commit your actual '.env' file to version control!
# ==============================================================================

# Google Gemini API Key (Required for online Gemini models)
# Obtain API key: https://ai.google.dev/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenAI API Key (Optional, for ChatGPT models like gpt-4o, gpt-4o-mini)
# Get an API key at: https://platform.openai.com/
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Anthropic API Key (Optional, for Claude models like claude-3-5-sonnet)
# Get an API key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

